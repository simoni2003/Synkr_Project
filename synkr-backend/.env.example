# Servidor
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=synkr
DB_PASSWORD=synkr
DB_NAME=synkr
# true = o TypeORM cria/atualiza as tabelas sozinho (so para desenvolvimento).
# Em producao usar migracoes (planeado para a Fase 9).
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT (gera segredos longos e diferentes: openssl rand -hex 32)
JWT_ACCESS_SECRET=troca-isto-por-um-segredo-longo-1
JWT_REFRESH_SECRET=troca-isto-por-outro-segredo-longo-2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Banco de tempo: credito inicial dado ao confirmar o e-mail (60 = 1 hora; 0 = desativado)
CREDIT_SIGNUP_BONUS_MINUTES=60
